  "elementMap": {
    "fire": { "color": "orange", "department": "Marketing, PR, Sales, Brand & Creative" },
    "wood": { "color": "salmonPink", "department": "Strategy, R&D, Innovation, Product Design" },
    "earth": { "color": "green", "department": "HR, People Ops, Customer Success, Admin" },
    "water": { "color": "navy", "department": "Data Analytics, Logistics, Supply Chain, Exec Strategy" },
    "gold": { "color": "amber", "department": "Finance, Legal, Compliance, QA & Audit" }
  },
  "typography": {
    "fontFamily": {
      "primary": "'Mulish', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "secondary": "'Source Serif 4', Georgia, 'Times New Roman', serif"
    },
    "scale": {
      "display":      { "font": "primary", "size": 40, "sizeLg": 48, "lineHeight": 56, "lineHeightLg": 66, "weight": 800, "letterSpacing": "0" },
      "h1":           { "font": "primary", "size": 32, "sizeLg": 40, "lineHeight": 38, "lineHeightLg": 56, "weight": 800, "letterSpacing": "0" },
      "h2":           { "font": "primary", "size": 26, "sizeLg": 32, "lineHeight": 36, "lineHeightLg": 44, "weight": 800, "letterSpacing": "0" },
      "h3":           { "font": "primary", "size": 22, "sizeLg": 24, "lineHeight": 30, "lineHeightLg": 34, "weight": 800, "letterSpacing": "0" },
      "h4":           { "font": "primary", "size": 20, "sizeLg": 22, "lineHeight": 28, "lineHeightLg": 30, "weight": 800, "letterSpacing": "0" },
      "h5":           { "font": "primary", "size": 16, "lineHeight": 20, "weight": 700, "letterSpacing": "0" },
      "body1":        { "font": "primary", "size": 16, "lineHeight": 22, "weight": 500, "letterSpacing": "0" },
      "body1Strong":  { "font": "primary", "size": 16, "lineHeight": 22, "weight": 700, "letterSpacing": "0" },
      "body2":        { "font": "primary", "size": 14, "lineHeight": 20, "weight": 400, "letterSpacing": "0" },
      "body2Strong":  { "font": "primary", "size": 14, "lineHeight": 20, "weight": 700, "letterSpacing": "0" },
      "label1":       { "font": "primary", "size": 14, "lineHeight": 20, "weight": 700, "letterSpacing": "0" },
      "label2":       { "font": "primary", "size": 13, "lineHeight": 18, "weight": 700, "letterSpacing": "0" },
      "label3":       { "font": "primary", "size": 11, "lineHeight": 16, "weight": 700, "letterSpacing": "0.04em" },
      "link1":        { "font": "primary", "size": 16, "lineHeight": 24, "weight": 500, "letterSpacing": "0" },
      "link2":        { "font": "primary", "size": 13, "lineHeight": 18, "weight": 500, "letterSpacing": "0" },
      "footnote":     { "font": "primary", "size": 12, "lineHeight": 16, "weight": 400, "letterSpacing": "0" },
      "caption":      { "font": "primary", "size": 12, "lineHeight": 16, "weight": 400, "letterSpacing": "0" }
    },
    "proseLineHeight": 1.65,
    "note": "Secondary font (Source Serif 4) is used only for deliberate brand-statement moments (pitch-deck ledes, pull quotes, hero numerals) layered on top of this functional scale, not as a swap-in for any token above — see DESIGN-SYSTEM.md Typography."
  },
  "spacing": {
    "spacing2": 2, "spacing4": 4, "spacing6": 6, "spacing8": 8, "spacing12": 12, "spacing16": 16, "spacing20": 20,
    "spacing24": 24, "spacing32": 32, "spacing40": 40, "spacing48": 48, "spacing60": 60,
    "spacing120": 120,
    "cardPadding": 16, "elementGap": 8, "sectionGap": 48, "pageGutter": 32,
    "contentMaxWidth": 1200,
    "measureSm": 360, "measureMd": 420, "measureLg": 440, "measureProse": 760
  },
  "layers": {
    "zFloat": 20, "zBar": 40, "zMenu": 60, "zPanel": 70, "zChat": 95,
    "zModal": 300, "zBrief": 400, "zTooltip": 500, "zToast": 1000, "zTour": 1100
  },
  "controlSizes": {
    "heightXs": 24, "heightSm": 32, "heightMd": 40, "heightLg": 48,
    "hitTargetMin": 44, "choiceSize": 18
  },
  "focusRing": {
    "width": 2, "color": "#2B2B2C", "offset": 2, "offsetInset": -2
  },
  "borderWidth": { "sm": 1, "md": 2 },
  "radius": {
    "xs": 6, "sm": 12, "md": 16, "lg": 20, "pill": 999, "link": 32
  },
  "elevation": {
    "hairline": "0 0 0 1px #d8d8d8",
    "shadow1": "0 1px 2px rgba(189,189,189,.45)",
    "shadow2": "0 2px 8px rgba(189,189,189,.42)",
    "shadow3": "0 8px 24px rgba(189,189,189,.40)",
    "shadow4": "0 16px 48px rgba(189,189,189,.44)",
    "focus": "0 0 0 3px rgba(20,115,230,.28)",
    "overlay": "rgba(8,8,8,.56)"
  },
  "motion": {
    "duration": { "instant": 80, "fast": 140, "base": 220, "slow": 360, "ambient": 900, "morph": 420, "reveal": 550, "pulse": 1400, "blink": 500 },
    "stagger": { "sm": 80, "md": 120 },
    "easing": {
      "standard": "cubic-bezier(.2,.6,.2,1)",
      "settle": "cubic-bezier(.16,.84,.24,1)",
      "flow": "cubic-bezier(.37,0,.29,1)",
      "flare": "cubic-bezier(.05,.7,.1,1)",
      "precise": "cubic-bezier(.4,0,.2,1)",
      "grow": "cubic-bezier(.25,.46,.45,.94)",
      "morph": "cubic-bezier(.22,1,.36,1)",
      "reveal": "cubic-bezier(.16,1,.3,1)"
    }
  },
  "icon": {
    "xs": 12, "micro": 14, "sm": 16, "base": 20, "md": 24, "lg": 32, "empty": 48, "hero": 64
  }
}
